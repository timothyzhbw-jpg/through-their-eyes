# Every environment variable the project reads. Copy to .env (git-ignored) or let
# infra/m0_provision.sh write .env for you. Never commit real values.

# --- Subscription (required by infra/m0_provision.sh) ---
# Subscription to bill. Must be Azure for Students, pay-as-you-go or free trial; Microsoft
# internal and Enterprise Agreement subscriptions are refused (see the script).
AZURE_SUBSCRIPTION_ID=
# Tenant of that subscription; written by the script and used by the smoke test's az credential.
AZURE_TENANT_ID=
# Set to 1 only if the owner of a non-personal subscription approved this use.
TTE_ALLOW_ANY_OFFER=

# --- Provisioning inputs (infra/m0_provision.sh); all optional, defaults shown ---
# Azure region for every M0 resource. Azure for Students may restrict regions.
AZURE_LOCATION=eastus2
AZURE_RESOURCE_GROUP=rg-through-their-eyes
# Random suffix that makes resource names globally unique; generated on first run.
TTE_SUFFIX=
# Resource names; default to tte-ai-<suffix> / tte-speech-<suffix>.
AZURE_AI_ACCOUNT=
AZURE_AI_PROJECT=through-their-eyes
AZURE_SPEECH_ACCOUNT=
# Models tried in order; the first one available in the region with quota is deployed.
MODEL_CANDIDATES="gpt-4.1-mini gpt-5-mini gpt-5-nano gpt-4o-mini"
DEPLOYMENT_SKU=GlobalStandard
# Deployment capacity in thousands of tokens per minute (capped by available quota).
DEPLOYMENT_CAPACITY=20

# --- Microsoft Foundry (read by Agent Framework's FoundryChatClient) ---
# https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
# Model deployment name.
FOUNDRY_MODEL=

# --- Hosting (written by infra/deploy.sh; all optional, defaults shown or derived) ---
# .env file the deploy script reads and writes.
TTE_ENV_FILE=.env
# Resource names; default to <kind>-<TTE_SUFFIX>.
TTE_LOGS_WORKSPACE=
TTE_APP_INSIGHTS=
TTE_COSMOS_ACCOUNT=
TTE_ACR=
TTE_ACA_ENV=
TTE_ACA_APP=tte-api
# User-assigned identity of the API app, and its client id (also set as AZURE_CLIENT_ID in the app).
TTE_API_IDENTITY=
TTE_API_CLIENT_ID=
# Identity GitHub Actions logs in as (OIDC), its client id, and the repo it trusts.
TTE_GITHUB_IDENTITY=
TTE_GITHUB_CLIENT_ID=
TTE_GITHUB_REPO=timothyzhbw-jpg/through-their-eyes
# Log Analytics daily ingestion cap in GB (the free allowance is 5 GB a month).
TTE_LOG_DAILY_CAP_GB=0.1
# Cosmos DB region: North Central US had no Cosmos capacity on 2026-10-20.
TTE_COSMOS_LOCATION=westus
# Public URL of the deployed API.
TTE_API_URL=
# Storage account of the static website (web/), and its public URL.
TTE_SITE_ACCOUNT=
TTE_WEB_URL=
# Application Insights connection string (not a secret, but environment-specific).
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Client id of the user-assigned managed identity; set only inside Azure Container Apps.
AZURE_CLIENT_ID=
# Set by Azure Container Apps itself when the app has a managed identity; never set it by hand.
IDENTITY_ENDPOINT=
# Cosmos DB endpoint (https://<account>.documents.azure.com:443/); unset = file store.
TTE_COSMOS_ENDPOINT=
# Cosmos DB database for the cache and the claims audit.
TTE_COSMOS_DATABASE=tte
# Model-backed regenerations allowed per UTC day across all clients (SPEC 8).
TTE_DAILY_MODEL_CAP=40

# --- Azure AI Speech (TTS) ---
AZURE_SPEECH_REGION=
# Secret. Key 1 of the Speech resource.
AZURE_SPEECH_KEY=

# --- API service (api/main.py) ---
# Matches the service replays, as scenario:seed pairs.
TTE_MATCHES=blind_side_run:3
# Where breakdowns, what-if answers and synthesized audio are cached (one JSON file per key).
TTE_CACHE_DIR=out/cache
# Model-backed regenerations allowed per client, as count/window_seconds.
TTE_RATE_LIMIT=3/600
# Model-backed regenerations (breakdowns and what-if answers) allowed per UTC day across all
# clients; past it the service serves the cache or the offline template (SPEC 8).
TTE_DAILY_MODEL_CAP=40
# Allowed CORS origins, comma-separated ("*" for the public demo).
TTE_WEB_ORIGIN=*
