# Every environment variable the project reads. Copy to .env (git-ignored) or let
# infra/m0_provision.sh write .env for you. Never commit real values.

# --- Subscription (required by infra/m0_provision.sh) ---
# Subscription to bill. Must be Azure for Students, pay-as-you-go or free trial; Microsoft
# internal and Enterprise Agreement subscriptions are refused (see the script).
AZURE_SUBSCRIPTION_ID=
# Tenant of that subscription; written by the script and used by the smoke test's az credential.
AZURE_TENANT_ID=
# Set to 1 only if the owner of a non-personal subscription approved this use.
TTE_ALLOW_ANY_OFFER=

# --- Provisioning inputs (infra/m0_provision.sh); all optional, defaults shown ---
# Azure region for every M0 resource. Azure for Students may restrict regions.
AZURE_LOCATION=eastus2
AZURE_RESOURCE_GROUP=rg-through-their-eyes
# Random suffix that makes resource names globally unique; generated on first run.
TTE_SUFFIX=
# Resource names; default to tte-ai-<suffix> / tte-speech-<suffix>.
AZURE_AI_ACCOUNT=
AZURE_AI_PROJECT=through-their-eyes
AZURE_SPEECH_ACCOUNT=
# Models tried in order; the first one available in the region with quota is deployed.
MODEL_CANDIDATES="gpt-4.1-mini gpt-5-mini gpt-5-nano gpt-4o-mini"
DEPLOYMENT_SKU=GlobalStandard
# Deployment capacity in units of 1K tokens + 1 request per minute (gpt-4.1-mini GlobalStandard),
# capped by available quota. Billed per token, so capacity has no fixed cost.
DEPLOYMENT_CAPACITY=200

# --- Microsoft Foundry (read by Agent Framework's FoundryChatClient) ---
# https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
# Model deployment name.
FOUNDRY_MODEL=

# --- Hosting (written by infra/deploy.sh; all optional, defaults shown or derived) ---
# .env file the deploy script reads and writes.
TTE_ENV_FILE=.env
# Resource names; default to <kind>-<TTE_SUFFIX>.
TTE_LOGS_WORKSPACE=
TTE_APP_INSIGHTS=
TTE_COSMOS_ACCOUNT=
TTE_ACR=
TTE_ACA_ENV=
TTE_ACA_APP=tte-api
# User-assigned identity of the API app, and its client id (also set as AZURE_CLIENT_ID in the app).
TTE_API_IDENTITY=
TTE_API_CLIENT_ID=
# Identity GitHub Actions logs in as (OIDC), its client id, and the repo it trusts.
TTE_GITHUB_IDENTITY=
TTE_GITHUB_CLIENT_ID=
TTE_GITHUB_REPO=timothyzhbw-jpg/through-their-eyes
# Log Analytics daily ingestion cap in GB (the free allowance is 5 GB a month).
TTE_LOG_DAILY_CAP_GB=0.1
# Cosmos DB region: North Central US had no Cosmos capacity on 2026-10-20.
TTE_COSMOS_LOCATION=westus
# Public URL of the deployed API. `infra/deploy.sh web` and the deploy workflow (repo variable
# TTE_API_URL) build web/ with it as VITE_API_URL; unset, the web app plays its bundled data.
TTE_API_URL=
# Storage account of the static website (web/), and its public URL.
TTE_SITE_ACCOUNT=
TTE_WEB_URL=
# Application Insights connection string (not a secret, but environment-specific).
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Client id of the user-assigned managed identity; set only inside Azure Container Apps.
AZURE_CLIENT_ID=
# Set by Azure Container Apps itself when the app has a managed identity; never set it by hand.
IDENTITY_ENDPOINT=

# --- Azure AI Speech (TTS) ---
AZURE_SPEECH_REGION=
# Secret. Key 1 of the Speech resource.
AZURE_SPEECH_KEY=

# --- Application Insights (agents/telemetry.py: configure_tracing) ---
# Secret-ish: connection string of the Application Insights resource. Empty: no tracing.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- API service (api/main.py) ---
# Matches the service replays, as scenario:seed pairs; "match:<seed>" is a stitched match of
# several possessions (sim/match.py, SPEC 3.1).
TTE_MATCHES=blind_side_run:3,corner_blind_side:0,match:1,press_escape:0
# Where breakdowns, what-if answers and synthesized audio are cached (one JSON file per key).
TTE_CACHE_DIR=out/cache
# Model-backed regenerations allowed per client, as count/window_seconds.
TTE_RATE_LIMIT=3/600
# Tamper checks (POST /api/verify: the verifier on a claim with one number changed; no model)
# allowed per client, as count/window_seconds.
TTE_VERIFY_RATE_LIMIT=20/60
# Model-backed regenerations (breakdowns and what-if answers) allowed per UTC day across all
# clients; past it the service serves the cache or the offline template (SPEC 8).
TTE_DAILY_MODEL_CAP=40
# Allowed CORS origins, comma-separated ("*" for the public demo).
TTE_WEB_ORIGIN=*
# POST /api/tts requests allowed per client (cached audio included), as count/window_seconds.
TTE_TTS_RATE_LIMIT=60/600
# Azure Speech syntheses (audio cache misses) allowed per UTC day across all clients; past it,
# POST /api/tts answers 429 for lines not yet synthesized and the captions play without voice.
# Only stored syntheses count; a failed Azure call gives its unit back.
TTE_DAILY_TTS_CAP=200
# Azure Speech calls in flight at once in this process; further misses wait their turn, so a burst
# cannot take every worker thread.
TTE_TTS_CONCURRENCY=4
# Live streams (/ws/matches/<id>/live) open at once per client address.
TTE_LIVE_PER_CLIENT=4
# Live streams open at once across all clients in this process (each replica has its own); past
# it, a new stream closes with 4429.
TTE_LIVE_MAX_TOTAL=64
# Longest live stream in seconds, paused time included; then it closes with 4408.
# match-1 runs about 12 minutes.
TTE_LIVE_MAX_S=1200
# With a model, the Analyst inspects the moment through our MCP tool server (agents/mcp_server.py),
# started as a subprocess for each uncached breakdown: about 3 s on 0.5 vCPU, about 90 MB, and
# about 5.7k more input tokens. 0 / false / off: no tools, as before 2026-10-20. Default on.
TTE_ANALYST_MCP=1
# Load (simulate) every match in TTE_MATCHES at startup, before the port opens, so the first
# request after a deploy or restart does not wait for it: the stitched match takes longer on
# 0.5 vCPU than the web app waits for its export. 0 / false / off: load each on first request.
# Default on.
TTE_WARM=1
# Cosmos DB account endpoint (https://<account>.documents.azure.com:443/). When set, cached results
# go to the container `cache` (partition key /kind) and verdicts to `claims_audit` (/match_id)
# instead of TTE_CACHE_DIR, keyless (the managed identity in Azure, `az login` locally).
# Empty: the file store.
TTE_COSMOS_ENDPOINT=
# Database holding those two containers.
TTE_COSMOS_DATABASE=tte

# --- Web app (web/, read by Vite at build time; see web/README.md) ---
# Base URL of the API service. Unset, or when the service does not answer within a few seconds,
# the app plays its bundled data and says "Offline data". Builds take it from TTE_API_URL.
VITE_API_URL=
# Dev only: `npm run dev` forwards /health, /api and /ws to this API (whose CORS allows only the
# site); then set VITE_API_URL=http://localhost:5173.
TTE_API_PROXY=
